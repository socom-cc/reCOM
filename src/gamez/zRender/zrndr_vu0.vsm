	subi.x vf30x,vf00x,i               	ibeq vi07,vi00,IntersectionDone
NextFace5:
	nop                                	iaddiu vi10,vi00,0x40
	nop                                	nop
	nop                                	iand vi06,vi09,vi10
	nop                                	nop
	nop                                	iand vi06,vi06,vi05
	nop                                	nop
	nop                                	ibne vi06,vi00,NoIntersections
	nop                                	nop
	nop                                	div q,vf06y,vf05y
	nop                                	waitq
	mulq.xyz vf10xyz,vf05xyz,q         	nop
	nop                                	nop
	nop                                	nop
	nop                                	nop
	add.xyz vf10xyz,vf02xyz,vf10xyz    	nop
	nop                                	nop
	nop                                	nop
	nop                                	nop
	sub.xyz vf11xyz,vf10xyz,vf03xyz    	nop
	nop                                	iaddiu vi06,vi00,0xa0
	nop                                	nop
	nop                                	nop
	nop                                	fmand vi07,vi06
	nop                                	ibgtz vi07,NoIntersections
	sub.xyz vf11xyz,vf04xyz,vf10xyz    	nop
	addx.xyz vf30xyz,vf00xyz,vf00x     	nop
	nop                                	nop
	nop                                	nop
	nop                                	fmand vi07,vi06
	subi.y vf30y,vf00y,i               	ibeq vi07,vi00,IntersectionDone
	nop                                	nop
	nop                                	b NoIntersections
	nop                                	nop
IntersectionDone:
	nop[i]                             	loi 0x3f800000
	addi.w vf10w,vf10w,i               	nop
NoIntersections:
	nop                                	nop
	nop[e]                             	nop	; E bit: stop after the next pair
	nop                                	nop

; Slot 0: segment against an edge list (NextEdge, NextEdgeList).
vu0GetIntersect:
	sub[i].xyz vf26xyz,vf02xyz,vf04xyz 	loi 0xb727c5ac
	sub.xyz vf27xyz,vf01xyz,vf04xyz    	nop
	nop                                	iaddiu vi04,vi00,0x155
	addi.xyz vf29xyz,vf00xyz,i         	mtir vi10,vf03w
	mul.xyz vf26xyz,vf26xyz,vf03xyz    	nop
	mul[i].xyz vf27xyz,vf27xyz,vf03xyz 	loi 0xbf800054
	addi.w vf29w,vf00w,i               	nop
	nop                                	mtir vi11,vf02w
	mulax.w accw,vf00w,vf26x           	nop
	madday.w accw,vf00w,vf26y          	nop
	maddz.w vf30w,vf00w,vf26z          	nop
	mulax.w accw,vf00w,vf27x           	nop
	madday.w accw,vf00w,vf27y          	nop
	maddz.w vf31w,vf00w,vf27z          	nop
	nop                                	nop
	nop                                	nop
	nop                                	nop
	addw.z vf31z,vf00z,vf30w           	nop
	nop                                	iaddiu vi05,vi00,0x30
	nop                                	nop
	nop                                	nop
	sub.zw vf29zw,vf31zw,vf29zw        	nop
	nop                                	nop
	nop                                	nop
	nop                                	nop
	nop                                	fmand vi02,vi05
	subw.z vf29z,vf31z,vf31w           	ibeq vi02,vi00,vu0_NoIntersect
	nop                                	isub vi06,vi02,vi11
	nop                                	nop
	nop                                	ibeq vi06,vi00,vu0_NoIntersect
	nop                                	nop
	nop                                	div q,vf31z,vf29z
	sub.xyz vf29xyz,vf01xyz,vf02xyz    	nop
	nop                                	waitq
	mulq.xyz vf29xyz,vf29xyz,q         	nop
	add.xyz vf29xyz,vf29xyz,vf02xyz    	nop
	nop                                	nop
	nop                                	iaddi vi04,vi04,-3
	nop                                	nop
	sub.xyz vf25xyz,vf29xyz,vf04xyz    	nop
	nop                                	nop
NextEdge:
	nop                                	ibeq vi10,vi00,vu0_IntersectDone
	addw[i].x vf30x,vf00x,vf30w        	loi 0xbf800000
	mul.xyz vf25xyz,vf25xyz,vf05xyz    	iaddi vi10,vi10,-1
	nop                                	nop
	nop[i]                             	loi 0xb727c5ac
	mulai.w accw,vf00w,i               	nop
	maddax.w accw,vf00w,vf25x          	nop
	madday.w accw,vf00w,vf25y          	nop
	maddz.w vf31w,vf00w,vf25z          	nop
	nop                                	nop
	nop                                	iaddiu vi05,vi00,0x10
	nop                                	iaddiu vi04,vi04,3
	nop                                	fmand vi06,vi05
	nop                                	nop
	nop                                	ibne vi06,vi00,vu0_NoIntersect
	nop                                	nop
	nop                                	jr vi04
	nop                                	nop
NextEdgeList:
	sub.xyz vf25xyz,vf29xyz,vf06xyz    	nop
	addx.xyz vf05xyz,vf07xyz,vf00x     	b NextEdge
	nop                                	nop
	sub.xyz vf25xyz,vf29xyz,vf08xyz    	nop
	addx.xyz vf05xyz,vf09xyz,vf00x     	b NextEdge
	nop                                	nop
	sub.xyz vf25xyz,vf29xyz,vf10xyz    	nop
	addx.xyz vf05xyz,vf11xyz,vf00x     	b NextEdge
	nop                                	nop
	sub.xyz vf25xyz,vf29xyz,vf12xyz    	nop
	addx.xyz vf05xyz,vf13xyz,vf00x     	b NextEdge
	nop                                	nop
	sub.xyz vf25xyz,vf29xyz,vf14xyz    	nop
	addx.xyz vf05xyz,vf15xyz,vf00x     	b NextEdge
	nop                                	nop
	sub.xyz vf25xyz,vf29xyz,vf16xyz    	nop
	addx.xyz vf05xyz,vf17xyz,vf00x     	b NextEdge
	nop                                	nop
	sub.xyz vf25xyz,vf29xyz,vf18xyz    	nop
	addx.xyz vf05xyz,vf19xyz,vf00x     	b NextEdge
	nop                                	nop
	sub.xyz vf25xyz,vf29xyz,vf20xyz    	nop
	addx.xyz vf05xyz,vf21xyz,vf00x     	b NextEdge
	nop                                	nop
	sub.xyz vf25xyz,vf29xyz,vf22xyz    	nop
	addx.xyz vf05xyz,vf23xyz,vf00x     	b NextEdge
	nop                                	nop
vu0_IntersectDone:
	nop                                	iaddiu vi05,vi00,0x20
	nop                                	iand vi02,vi02,vi05
	nop                                	nop
	addx.w vf29w,vf00w,vf00x           	ibeq vi02,vi00,NormalOK
	nop                                	nop
	muli.xyz vf03xyz,vf03xyz,i         	nop
NormalOK:
	nop[e]                             	nop	; E bit: stop after the next pair
	nop                                	nop
vu0_NoIntersect:
	nop                                	mr32.w vf29w,vf00w
	nop[e]                             	nop	; E bit: stop after the next pair
	nop                                	nop

; Slot 2: segment against the polygon plane.
vu0IntersectPlaneTest:
	nop                                	lq.xyzw vf02xyzw,1(vi00)
	nop                                	lq.xyzw vf01xyzw,0(vi00)
	sub.xyz vf07xyz,vf05xyz,vf04xyz    	nop
	add.xyz vf06xyz,vf00xyz,vf04xyz    	nop
	sub[i].xyz vf26xyz,vf02xyz,vf04xyz 	loi 0xb727c5ac
	sub.xyz vf27xyz,vf01xyz,vf04xyz    	nop
	nop                                	nop
	addi.xyz vf29xyz,vf00xyz,i         	nop
	mul.xyz vf26xyz,vf26xyz,vf03xyz    	nop
	mul[i].xyz vf27xyz,vf27xyz,vf03xyz 	loi 0xbf800054
	nop                                	nop
	nop                                	mtir vi11,vf02w
	mulax.w accw,vf00w,vf26x           	nop
	madday.w accw,vf00w,vf26y          	nop
	maddz.w vf30w,vf00w,vf26z          	nop
	mulax.w accw,vf00w,vf27x           	nop
	madday.w accw,vf00w,vf27y          	nop
	maddz.w vf31w,vf00w,vf27z          	nop
	opmula.xyz accxyz,vf03xyz,vf07xyz  	nop
	opmsub.xyz vf08xyz,vf07xyz,vf03xyz 	nop
	nop                                	nop
	addw.z vf31z,vf00z,vf30w           	nop
	nop                                	iaddiu vi05,vi00,0x30
	nop                                	nop
	nop                                	nop
	sub.zw vf29zw,vf31zw,vf29zw        	nop
	nop                                	nop
	nop                                	nop
	nop                                	nop
	nop                                	fmand vi02,vi05
	nop                                	nop
	subw.z vf29z,vf31z,vf31w           	ibeq vi02,vi00,vu0_FailPlaneTest
	nop                                	isub vi06,vi02,vi11
	nop                                	ibeq vi02,vi05,vu0_FailPlaneTest
	nop                                	nop
	nop                                	ibeq vi06,vi00,vu0_FailPlaneTest
	nop                                	nop
	addx.w vf29w,vf00w,vf00x           	div q,vf31z,vf29z
	nop                                	nop
	nop                                	nop
	nop                                	nop
	sub.xyz vf29xyz,vf01xyz,vf02xyz    	nop
	nop                                	waitq
	mulq.xyz vf29xyz,vf29xyz,q         	nop
	add.xyz vf29xyz,vf29xyz,vf02xyz    	nop
	nop[e]                             	nop	; E bit: stop after the next pair
	nop                                	nop
vu0_FailPlaneTest:
	nop                                	mr32.w vf29w,vf00w
	nop[e]                             	nop	; E bit: stop after the next pair
	nop                                	nop

; Slot 4: inside test of the plane hit point against the polygon edges.
vu0IntersectWithEdges:
	sub.xyz vf25xyz,vf29xyz,vf06xyz    	nop
	nop                                	nop
	addw.x vf30x,vf00x,vf30w           	nop
	nop                                	nop
	mul.xyz vf25xyz,vf25xyz,vf08xyz    	nop
	sub.xyz vf07xyz,vf05xyz,vf04xyz    	nop
	add[i].xyz vf06xyz,vf00xyz,vf05xyz 	loi 0xb727c5ac
	mulai.w accw,vf00w,i               	nop
	maddax.w accw,vf00w,vf25x          	nop
	madday.w accw,vf00w,vf25y          	nop
	maddz.w vf31w,vf00w,vf25z          	nop
	nop                                	nop
	nop                                	iaddiu vi05,vi00,0x10
	nop                                	nop
	nop                                	fmand vi06,vi05
	opmula.xyz accxyz,vf03xyz,vf07xyz  	nop
	opmsub.xyz vf08xyz,vf07xyz,vf03xyz 	ibne vi06,vi00,vu0_NoIntersect3
	nop                                	iaddiu vi05,vi00,0x20
	nop                                	iand vi02,vi02,vi05
	nop                                	nop
	addx.w vf29w,vf00w,vf00x           	ibeq vi02,vi00,NormalOK3
	nop[i]                             	loi 0xbf800000
	muli.xyz vf03xyz,vf03xyz,i         	nop
