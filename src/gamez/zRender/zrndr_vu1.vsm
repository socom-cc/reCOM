	nop                                	nop
	miniw.w vf29w,vf29w,vf00w          	nop
	miniw.w vf30w,vf30w,vf00w          	nop
	nop                                	nop
	mulw.z vf31z,vf31z,vf27w           	nop
	maxy.w vf29w,vf29w,vf00y           	nop
	maxy.w vf30w,vf30w,vf00y           	nop
	nop                                	nop
	miniw.z vf31z,vf31z,vf00w          	nop
	mulw.w vf29w,vf29w,vf30w           	nop
	mulw.w vf26w,vf26w,vf29w           	nop
	nop                                	nop
	nop                                	nop
	nop                                	nop
	nop                                	nop
	nop                                	lq.xyzw vf24xyzw,0(vi03)
	nop                                	lq.xyzw vf25xyzw,1(vi03)
	nop                                	iaddi vi09,vi09,-1
	nop                                	sq.xyzw vf26xyzw,1(vi04)
	nop                                	ibne vi09,vi00,NextShadowVertex
	nop                                	iaddiu vi04,vi04,3
	nop                                	ibne vi07,vi00,vuNextShadowMap
	nop                                	nop
	nop                                	jr vi06
	nop                                	nop
vuMPShadowMap0:
	nop                                	iaddiu vi03,vi01,4
	nop                                	iaddiu vi04,vi00,VU1_VTX_A
	nop                                	iaddiu vi06,vi00,vuGatherFixKick
	nop                                	b vuFirstShadowMap
	nop                                	ilw.z vi09,2(vi01)z
vuMPShadowMap1:
	nop                                	iadd vi03,vi00,vi08
	nop                                	iaddiu vi04,vi00,VU1_VTX_B
	nop                                	iaddiu vi06,vi00,vuFixKick1
	nop                                	b vuFirstShadowMap
	nop                                	iaddiu vi09,vi10,0

; Command 102: normals from the triangle list. port: guess from the name.
vuBuildNormals:
	nop                                	ilw.x vi04,2(vi01)x
	nop                                	iaddiu vi03,vi01,4
	nop                                	iadd vi04,vi04,vi01
	nop                                	ilw.w vi13,2(vi01)w
	nop                                	ilw.x vi05,0(vi04)x
	nop                                	ilw.y vi06,0(vi04)y
	nop                                	ilw.z vi07,0(vi04)z
	nop                                	nop
	nop                                	iadd vi05,vi03,vi05
	nop                                	lq.xyzw vf17xyzw,0(vi05)
	nop                                	iadd vi06,vi03,vi06
	nop                                	lq.xyzw vf18xyzw,0(vi06)
	nop                                	iadd vi07,vi03,vi07
	nop                                	lq.xyzw vf19xyzw,0(vi07)
	nop                                	nop
	nop                                	nop
NextTriBuildNormal:
	sub.xyz vf26xyz,vf17xyz,vf18xyz    	iaddi vi13,vi13,-1
	sub.xyz vf28xyz,vf19xyz,vf18xyz    	iaddi vi04,vi04,2
	nop                                	nop
	nop                                	ilw.x vi05,0(vi04)x
	nop                                	ilw.y vi06,0(vi04)y
	opmula.xyz accxyz,vf28xyz,vf26xyz  	ilw.z vi07,0(vi04)z
	opmsub.xyz vf29xyz,vf26xyz,vf28xyz 	nop
	nop                                	iadd vi05,vi03,vi05
	nop                                	lq.xyzw vf17xyzw,0(vi05)
	nop                                	iadd vi06,vi03,vi06
	ftoi15.xyz vf29xyz,vf29xyz         	lq.xyzw vf18xyzw,0(vi06)
	nop                                	iadd vi07,vi03,vi07
	nop                                	lq.xyzw vf19xyzw,0(vi07)
	nop                                	ibgtz vi13,NextTriBuildNormal
	nop                                	sq.xyzw vf29xyzw,-1(vi04)
	nop                                	b vuProcessNextCommand
	nop                                	nop

; Line clipping against one plane (helper of VU1_LINE_CLIPPER).
CLIP_LINE_CHECK:
	sub.xyzw vf25xyzw,vf21xyzw,vf28xyzw	nop
	sub.xyzw vf26xyzw,vf17xyzw,vf28xyzw	nop
	nop                                	nop
	nop                                	nop
	mul.xyz vf25xyz,vf25xyz,vf30xyz    	nop
	mul.xyz vf26xyz,vf26xyz,vf30xyz    	nop
	nop                                	nop
	nop                                	nop
	mulax.w accw,vf00w,vf25x           	nop
	madday.w accw,vf00w,vf25y          	iaddiu vi07,vi00,0x20
	maddz.w vf25w,vf00w,vf25z          	nop
	addw.z vf25z,vf00z,vf25w           	nop
	nop                                	nop
	nop                                	nop
	nop                                	nop
	mulax.w accw,vf00w,vf26x           	fmand vi07,vi07
	madday.w accw,vf00w,vf26y          	iaddiu vi13,vi00,0x10
	maddz.w vf26w,vf00w,vf26z          	nop
	nop                                	nop
	nop                                	nop
	nop                                	nop
	nop                                	fmand vi13,vi13
	nop                                	nop
	nop                                	ior vi13,vi13,vi07
	subz.w vf25w,vf26w,vf25z           	iaddiu vi07,vi00,0x30
	nop                                	ibeq vi13,vi00,CLIP_LINE_END
	nop                                	nop
	nop                                	ibeq vi13,vi07,CLIP_LINE_OUT
	nop                                	nop
	nop                                	div q,vf26w,vf25w
	sub.xyzw vf25xyzw,vf21xyzw,vf17xyzw	nop
	sub.xyzw vf26xyzw,vf22xyzw,vf18xyzw	nop
	sub.xyzw vf27xyzw,vf23xyzw,vf19xyzw	nop
	nop                                	waitq
	mulq.xyzw vf25xyzw,vf25xyzw,q      	nop
	mulq.xyzw vf26xyzw,vf26xyzw,q      	nop
	mulq.xyzw vf27xyzw,vf27xyzw,q      	nop
	nop                                	nop
	add.xyzw vf25xyzw,vf25xyzw,vf17xyzw	nop
	add.xyzw vf26xyzw,vf26xyzw,vf18xyzw	iaddiu vi07,vi00,0x10
	add.xyzw vf27xyzw,vf27xyzw,vf19xyzw	nop
	nop                                	ibeq vi13,vi07,CO_NEXT_IN_LINE
	nop                                	nop
	nop                                	b CI_NEXT_OUT_LINE
	nop                                	nop
CO_NEXT_IN_LINE:
	addx.xyzw vf17xyzw,vf25xyzw,vf00x  	nop
	addx.xyzw vf18xyzw,vf26xyzw,vf00x  	nop
	addx.xyzw vf19xyzw,vf27xyzw,vf00x  	nop
	nop                                	b CLIP_LINE_END
	nop                                	nop
CI_NEXT_OUT_LINE:
	addx.xyzw vf21xyzw,vf25xyzw,vf00x  	nop
	addx.xyzw vf22xyzw,vf26xyzw,vf00x  	nop
	addx.xyzw vf23xyzw,vf27xyzw,vf00x  	nop
	nop                                	b CLIP_LINE_END
	nop                                	nop
CLIP_LINE_OUT:
	nop                                	iaddiu vi11,vi00,0
CLIP_LINE_END:
	nop                                	jr vi02
	nop                                	nop

; Command 82: CMesh vertex blending (one weight or all weights); colours x VU1_COLOR128.
vuCMesh:
	nop                                	iaddi vi04,vi01,0
	nop                                	iaddiu vi02,vi01,5
	nop                                	lqi.xyzw vf23xyzw,(vi04++)
	nop                                	lqi.xyzw vf24xyzw,(vi04++)
	nop                                	lqi.xyzw vf25xyzw,(vi04++)
	nop                                	lqi.xyzw vf26xyzw,(vi04++)
	nop                                	ilwr.x vi05,(vi04)x
	nop                                	ilwr.w vi10,(vi04)w
	nop                                	ilwr.w vi04,(vi02)w
	nop                                	iaddiu vi07,vi00,1
	nop                                	iand vi07,vi05,vi07
	nop                                	nop
	nop                                	ibgtz vi07,CMESH_DO_ALL
	nop                                	nop
CMESH_ONE_WT_OR_FIRST:
	nop                                	iaddiu vi03,vi00,VU1_VTX_A
	nop                                	isw.x vi03,VU1_CMESH_SAVE(vi00)x
	nop                                	iadd vi06,vi03,vi04
	nop                                	iadd vi09,vi00,vi10
	nop                                	lq.xyzw vf19xyzw,0(vi02)
	nop                                	lq.xyzw vf20xyzw,1(vi02)
	nop                                	nop
	nop                                	nop
CMESH_ONE_WT_OR_FIRST_LOOP:
	itof15[i].xyz vf19xyz,vf19xyz      	loi 0x41200000
	itof15.xyzw vf20xyzw,vf20xyzw      	nop
	nop                                	nop
	nop                                	nop
	muli.xyz vf19xyz,vf19xyz,i         	nop
	nop                                	nop
	nop                                	nop
	mulw.xyz vf19xyz,vf19xyz,vf20w     	nop
	mulw.xyz vf20xyz,vf20xyz,vf20w     	nop
	nop                                	nop
	nop                                	nop
	mulax.xyz accxyz,vf23xyz,vf19x     	nop
	madday.xyz accxyz,vf24xyz,vf19y    	iaddiu vi02,vi02,2
	maddaz.xyz accxyz,vf25xyz,vf19z    	nop
	maddw.xyz vf27xyz,vf26xyz,vf20w    	ilwr.w vi04,(vi02)w
	mulax.xyz accxyz,vf23xyz,vf20x     	isubiu vi10,vi10,1
	madday.xyz accxyz,vf24xyz,vf20y    	nop
	maddz.xyz vf28xyz,vf25xyz,vf20z    	nop
	nop                                	sq.xyz vf27xyz,0(vi06)
	nop                                	lq.xyzw vf19xyzw,0(vi02)
	nop                                	lq.xyzw vf20xyzw,1(vi02)
	nop                                	sq.xyz vf28xyz,1(vi06)
	nop                                	ibne vi10,vi00,CMESH_ONE_WT_OR_FIRST_LOOP
	nop                                	iadd vi06,vi03,vi04
	nop                                	b ALL_DONE_CHECK
	nop                                	nop
CMESH_DO_ALL:
	nop                                	ilw.x vi03,VU1_CMESH_SAVE(vi00)x
	nop                                	nop
	nop                                	lq.xyzw vf19xyzw,0(vi02)
	nop                                	lq.xyzw vf20xyzw,1(vi02)
	nop                                	iadd vi06,vi03,vi04
	nop                                	nop
	nop                                	lq.xyzw vf29xyzw,0(vi06)
	nop                                	lq.xyzw vf30xyzw,1(vi06)
CMESH_DO_ALL_LOOP:
	itof15[i].xyz vf19xyz,vf19xyz      	loi 0x41200000
	itof15.xyzw vf20xyzw,vf20xyzw      	nop
	nop                                	nop
	nop                                	nop
	muli.xyz vf19xyz,vf19xyz,i         	nop
	nop                                	nop
	nop                                	nop
	mulaw.xyz accxyz,vf29xyz,vf00w     	nop
	mulw.xyz vf19xyz,vf19xyz,vf20w     	nop
	nop                                	nop
	nop                                	nop
	nop                                	nop
	maddax.xyz accxyz,vf23xyz,vf19x    	nop
	madday.xyz accxyz,vf24xyz,vf19y    	iaddiu vi02,vi02,2
	maddaz.xyz accxyz,vf25xyz,vf19z    	nop
	maddw.xyz vf27xyz,vf26xyz,vf20w    	ilwr.w vi04,(vi02)w
	mulaw.xyz accxyz,vf30xyz,vf00w     	nop
	mulw.xyz vf20xyz,vf20xyz,vf20w     	nop
	nop                                	nop
	nop                                	iadd vi12,vi03,vi04
	nop                                	nop
	maddax.xyz accxyz,vf23xyz,vf20x    	isubiu vi10,vi10,1
	madday.xyz accxyz,vf24xyz,vf20y    	sq.xyz vf27xyz,0(vi06)
	maddz.xyz vf28xyz,vf25xyz,vf20z    	lq.xyzw vf19xyzw,0(vi02)
	nop                                	lq.xyzw vf29xyzw,0(vi12)
	nop                                	lq.xyzw vf20xyzw,1(vi02)
	nop                                	lq.xyzw vf30xyzw,1(vi12)
	nop                                	sq.xyz vf28xyz,1(vi06)
	nop                                	ibne vi10,vi00,CMESH_DO_ALL_LOOP
	nop                                	iadd vi06,vi03,vi04
ALL_DONE_CHECK:
	nop[e]                             	nop	; E bit: stop after the next pair
	nop                                	nop
	nop                                	xtop vi01
	nop                                	iaddiu vi07,vi00,4
	nop                                	iand vi07,vi05,vi07
	nop                                	nop
	nop                                	ibeq vi07,vi00,vuCMesh
	nop                                	nop
REARRANGE_CMESH:
	nop                                	ilw.x vi02,VU1_CMESH_SAVE(vi00)x
	nop                                	iaddiu vi03,vi01,4
	nop                                	lq.xyzw vf28xyzw,VU1_COLOR128(vi00)
CMESH_Y:
	nop                                	lq.xyzw vf27xyzw,1(vi03)
	nop                                	lq.xyzw vf30xyzw,1(vi02)
	nop                                	lq.xyzw vf29xyzw,0(vi02)
	nop                                	iaddiu vi02,vi02,2
	mulz.w vf30w,vf00w,vf30z           	isubiu vi09,vi09,1
	addy.z vf30z,vf00z,vf30y           	nop
	itof12.xy vf27xy,vf27xy            	nop
	nop                                	nop
	nop                                	nop
	nop                                	mr32.w vf29w,vf30w
	nop                                	sq.xy vf27xy,1(vi03)
	nop                                	sq.zw vf30zw,1(vi03)
	nop                                	sq.xyzw vf28xyzw,2(vi03)
	nop                                	sq.xyzw vf29xyzw,0(vi03)
	nop                                	ibne vi09,vi00,CMESH_Y
	nop                                	iaddiu vi03,vi03,3
	nop                                	b vuProcessNextCommand
	nop                                	nop

; Clip a line against the Z-, X-, X+, Y-, Y+ planes (VU1_OBJ_PARAMS.x mask).
VU1_LINE_CLIPPER:
	nop                                	ilw.x vi04,VU1_OBJ_PARAMS(vi00)x
ZMINUSLINE:
	nop                                	iaddiu vi08,vi00,0x20
	nop                                	iand vi08,vi04,vi08
	nop                                	ibeq vi08,vi00,XMINUSLINE
	nop                                	lq.xyzw vf28xyzw,VU1_CAM_VECS+1(vi00)
	nop                                	lq.xyzw vf30xyzw,VU1_CAM_VECS+2(vi00)
	nop                                	bal vi02,CLIP_LINE_CHECK
	nop                                	nop
	nop                                	ibeq vi11,vi00,END_ALL_LINE
	nop                                	nop
XMINUSLINE:
	nop                                	iaddiu vi08,vi00,2
	nop                                	iand vi08,vi04,vi08
	nop                                	ibeq vi08,vi00,XPLUSLINE
	nop                                	lq.xyzw vf28xyzw,VU1_CAM_VECS(vi00)
	nop                                	lq.xyzw vf30xyzw,VU1_CAM_VECS+3(vi00)
	nop                                	bal vi02,CLIP_LINE_CHECK
	nop                                	nop
	nop                                	ibeq vi11,vi00,END_ALL_LINE
	nop                                	nop
XPLUSLINE:
	nop                                	iaddiu vi08,vi00,1
	nop                                	iand vi08,vi04,vi08
	nop                                	ibeq vi08,vi00,YMINUSLINE
	nop                                	lq.xyzw vf28xyzw,VU1_CAM_VECS(vi00)
	nop                                	lq.xyzw vf30xyzw,VU1_CAM_VECS+4(vi00)
	nop                                	bal vi02,CLIP_LINE_CHECK
	nop                                	nop
	nop                                	ibeq vi11,vi00,END_ALL_LINE
YMINUSLINE:
	nop                                	iaddiu vi08,vi00,8
	nop                                	iand vi08,vi04,vi08
	nop                                	ibeq vi08,vi00,YPLUSLINE
	nop                                	lq.xyzw vf28xyzw,VU1_CAM_VECS(vi00)
	nop                                	lq.xyzw vf30xyzw,VU1_CAM_VECS+5(vi00)
	nop                                	bal vi02,CLIP_LINE_CHECK
	nop                                	nop
	nop                                	ibeq vi11,vi00,END_ALL_LINE
	nop                                	nop
YPLUSLINE:
	nop                                	iaddiu vi08,vi00,4
	nop                                	iand vi08,vi04,vi08
	nop                                	ibeq vi08,vi00,END_ALL_LINE
	nop                                	lq.xyzw vf28xyzw,VU1_CAM_VECS(vi00)
	nop                                	lq.xyzw vf30xyzw,VU1_CAM_VECS+6(vi00)
	nop                                	bal vi02,CLIP_LINE_CHECK
	nop                                	nop
	nop                                	ibeq vi11,vi00,END_ALL_LINE
	nop                                	nop
END_ALL_LINE:
	nop                                	jr vi15
	nop                                	nop

; Clip a triangle against the Z-, X-, X+, Y-, Y+ planes (VU1_OBJ_PARAMS.x mask).
VU1_TRI_CLIPPER:
	mulax.xyzw accxyzw,vf13xyzw,vf17x  	ilw.x vi04,VU1_OBJ_PARAMS(vi00)x
	madday.xyzw accxyzw,vf14xyzw,vf17y 	iaddiu vi05,vi00,VU1_VTX_A
	maddaz.xyzw accxyzw,vf15xyzw,vf17z 	iadd vi08,vi00,vi05
	maddw.xyzw vf23xyzw,vf16xyzw,vf00w 	iaddiu vi06,vi00,0x4c
CLIP_TRI:
	mulax.xyzw accxyzw,vf13xyzw,vf26x  	sq.xyzw vf17xyzw,0(vi08)
	madday.xyzw accxyzw,vf14xyzw,vf26y 	sq.xyzw vf18xyzw,1(vi08)
	maddaz.xyzw accxyzw,vf15xyzw,vf26z 	sq.xyzw vf19xyzw,2(vi08)
	maddw.xyzw vf24xyzw,vf16xyzw,vf00w 	sq.xyzw vf26xyzw,3(vi08)
	mulax.xyzw accxyzw,vf13xyzw,vf29x  	sq.xyzw vf27xyzw,4(vi08)
	madday.xyzw accxyzw,vf14xyzw,vf29y 	sq.xyzw vf28xyzw,5(vi08)
	maddaz.xyzw accxyzw,vf15xyzw,vf29z 	sq.xyzw vf29xyzw,6(vi08)
	maddw.xyzw vf25xyzw,vf16xyzw,vf00w 	sq.xyzw vf30xyzw,7(vi08)
	clipw.xyz vf23xyz,vf23w            	sq.xyzw vf31xyzw,8(vi08)
	clipw.xyz vf24xyz,vf24w            	sq.xyzw vf17xyzw,9(vi08)
	nop                                	sq.xyzw vf18xyzw,10(vi08)
	clipw.xyz vf25xyz,vf25w            	sq.xyzw vf19xyzw,11(vi08)
TRI_ZMINUS:
	nop                                	iaddiu vi08,vi00,0x20
	nop                                	iand vi08,vi04,vi08
	nop                                	ibeq vi08,vi00,TRI_XMINUS
	nop                                	lq.xyzw vf28xyzw,VU1_CAM_VECS+1(vi00)
	nop                                	lq.xyzw vf30xyzw,VU1_CAM_VECS+2(vi00)
	nop                                	iadd vi08,vi00,vi05
	nop                                	iadd vi09,vi00,vi06
	nop                                	iaddiu vi10,vi00,3
	nop                                	iaddiu vi11,vi00,0
	nop                                	lqi.xyzw vf21xyzw,(vi08++)
	nop                                	lqi.xyzw vf22xyzw,(vi08++)
	nop                                	lqi.xyzw vf23xyzw,(vi08++)
TRI_LOOP_ZM:
	nop                                	bal vi02,CLIP_PLANE_CHECK
	nop                                	nop
	nop                                	isubiu vi10,vi10,1
	nop                                	nop
	nop                                	ibne vi10,vi00,TRI_LOOP_ZM
	nop                                	nop
	nop                                	iadd vi08,vi00,vi06
	nop                                	bal vi02,SAVE_LAST_VERTEX
	nop                                	ibeq vi11,vi00,TRI_END_ALL
	nop                                	iadd vi08,vi00,vi06
	nop                                	iadd vi06,vi00,vi05
	nop                                	iadd vi05,vi00,vi08
TRI_XMINUS:
	nop                                	iaddiu vi08,vi00,2
	nop                                	iand vi08,vi04,vi08
	nop                                	ibeq vi08,vi00,TRI_XPLUS
	nop                                	lq.xyzw vf28xyzw,VU1_CAM_VECS(vi00)
	nop                                	lq.xyzw vf30xyzw,VU1_CAM_VECS+3(vi00)
	nop                                	iadd vi08,vi00,vi05
	nop                                	iadd vi09,vi00,vi06
	nop                                	iadd vi10,vi00,vi11
	nop                                	iaddiu vi11,vi00,0
	nop                                	lqi.xyzw vf21xyzw,(vi08++)
	nop                                	lqi.xyzw vf22xyzw,(vi08++)
	nop                                	lqi.xyzw vf23xyzw,(vi08++)
TRI_LOOP_XM:
	nop                                	bal vi02,CLIP_PLANE_CHECK
	nop                                	nop
	nop                                	isubiu vi10,vi10,1
	nop                                	nop
	nop                                	ibne vi10,vi00,TRI_LOOP_XM
	nop                                	nop
	nop                                	iadd vi08,vi00,vi06
	nop                                	bal vi02,SAVE_LAST_VERTEX
	nop                                	ibeq vi11,vi00,TRI_END_ALL
	nop                                	iadd vi08,vi00,vi06
	nop                                	iadd vi06,vi00,vi05
	nop                                	iadd vi05,vi00,vi08
TRI_XPLUS:
	nop                                	iaddiu vi08,vi00,1
	nop                                	iand vi08,vi04,vi08
	nop                                	ibeq vi08,vi00,TRI_YMINUS
	nop                                	lq.xyzw vf28xyzw,VU1_CAM_VECS(vi00)
	nop                                	lq.xyzw vf30xyzw,VU1_CAM_VECS+4(vi00)
	nop                                	iadd vi08,vi00,vi05
	nop                                	iadd vi09,vi00,vi06
	nop                                	iadd vi10,vi00,vi11
	nop                                	iaddiu vi11,vi00,0
	nop                                	lqi.xyzw vf21xyzw,(vi08++)
	nop                                	lqi.xyzw vf22xyzw,(vi08++)
	nop                                	lqi.xyzw vf23xyzw,(vi08++)
TRI_LOOP_XP:
	nop                                	bal vi02,CLIP_PLANE_CHECK
	nop                                	nop
	nop                                	isubiu vi10,vi10,1
	nop                                	nop
	nop                                	ibne vi10,vi00,TRI_LOOP_XP
	nop                                	nop
	nop                                	iadd vi08,vi00,vi06
	nop                                	bal vi02,SAVE_LAST_VERTEX
	nop                                	nop
	nop                                	ibeq vi11,vi00,TRI_END_ALL
	nop                                	iadd vi08,vi00,vi06
	nop                                	iadd vi06,vi00,vi05
	nop                                	iadd vi05,vi00,vi08
TRI_YMINUS:
	nop                                	iaddiu vi08,vi00,8
	nop                                	iand vi08,vi04,vi08
	nop                                	ibeq vi08,vi00,TRI_YPLUS
	nop                                	lq.xyzw vf28xyzw,VU1_CAM_VECS(vi00)
	nop                                	lq.xyzw vf30xyzw,VU1_CAM_VECS+5(vi00)
	nop                                	iadd vi08,vi00,vi05
	nop                                	iadd vi09,vi00,vi06
	nop                                	iadd vi10,vi00,vi11
	nop                                	iaddiu vi11,vi00,0
	nop                                	lqi.xyzw vf21xyzw,(vi08++)
	nop                                	lqi.xyzw vf22xyzw,(vi08++)
	nop                                	lqi.xyzw vf23xyzw,(vi08++)
TRI_LOOP_YM:
	nop                                	bal vi02,CLIP_PLANE_CHECK
	nop                                	nop
	nop                                	isubiu vi10,vi10,1
	nop                                	nop
	nop                                	ibne vi10,vi00,TRI_LOOP_YM
	nop                                	nop
	nop                                	iadd vi08,vi00,vi06
	nop                                	bal vi02,SAVE_LAST_VERTEX
	nop                                	nop
	nop                                	ibeq vi11,vi00,TRI_END_ALL
	nop                                	iadd vi08,vi00,vi06
	nop                                	iadd vi06,vi00,vi05
	nop                                	iadd vi05,vi00,vi08
TRI_YPLUS:
	nop                                	iaddiu vi08,vi00,4
	nop                                	iand vi08,vi04,vi08
	nop                                	ibeq vi08,vi00,TRI_FINISHED
	nop                                	lq.xyzw vf28xyzw,VU1_CAM_VECS(vi00)
	nop                                	lq.xyzw vf30xyzw,VU1_CAM_VECS+6(vi00)
	nop                                	iadd vi08,vi00,vi05
	nop                                	iadd vi09,vi00,vi06
	nop                                	iadd vi10,vi00,vi11
	nop                                	iaddiu vi11,vi00,0
	nop                                	lqi.xyzw vf21xyzw,(vi08++)
	nop                                	lqi.xyzw vf22xyzw,(vi08++)
	nop                                	lqi.xyzw vf23xyzw,(vi08++)
TRI_LOOP_YP:
	nop                                	bal vi02,CLIP_PLANE_CHECK
	nop                                	nop
	nop                                	isubiu vi10,vi10,1
	nop                                	nop
	nop                                	ibne vi10,vi00,TRI_LOOP_YP
	nop                                	nop
	nop                                	iadd vi08,vi00,vi06
	nop                                	bal vi02,SAVE_LAST_VERTEX
	nop                                	nop
	nop                                	ibeq vi11,vi00,TRI_END_ALL
	nop                                	iadd vi08,vi00,vi06
	nop                                	iadd vi06,vi00,vi05
	nop                                	iadd vi05,vi00,vi08
TRI_FINISHED:
	nop                                	iaddi vi08,vi05,0
	nop                                	iadd vi10,vi00,vi11
TRI_END_ALL:
	nop                                	jr vi15
	nop                                	nop
SAVE_LAST_VERTEX:
	nop                                	lq.xyzw vf21xyzw,0(vi08)
	nop                                	lq.xyzw vf22xyzw,1(vi08)
	nop                                	lq.xyzw vf23xyzw,2(vi08)
	nop                                	sqi.xyzw vf21xyzw,(vi09++)
	nop                                	sqi.xyzw vf22xyzw,(vi09++)
	nop                                	sqi.xyzw vf23xyzw,(vi09++)
	nop                                	jr vi02
	nop                                	nop
CLIP_PLANE_CHECK:
	addx.xyzw vf17xyzw,vf21xyzw,vf00x  	lqi.xyzw vf21xyzw,(vi08++)
	addx.xyzw vf18xyzw,vf22xyzw,vf00x  	lqi.xyzw vf22xyzw,(vi08++)
	addx.xyzw vf19xyzw,vf23xyzw,vf00x  	lqi.xyzw vf23xyzw,(vi08++)
	sub.xyzw vf25xyzw,vf21xyzw,vf28xyzw	nop
	sub.xyzw vf26xyzw,vf17xyzw,vf28xyzw	nop
	nop                                	nop
	nop                                	nop
	mul.xyz vf25xyz,vf25xyz,vf30xyz    	nop
	mul.xyz vf26xyz,vf26xyz,vf30xyz    	nop
	nop                                	nop
	nop                                	nop
	mulax.w accw,vf00w,vf25x           	nop
	madday.w accw,vf00w,vf25y          	iaddiu vi07,vi00,0x20
	maddz.w vf25w,vf00w,vf25z          	nop
	addw.z vf25z,vf00z,vf25w           	nop
	mulax.w accw,vf00w,vf26x           	nop
	madday.w accw,vf00w,vf26y          	nop
	maddz.w vf26w,vf00w,vf26z          	nop
	nop                                	fmand vi07,vi07
	nop                                	iaddiu vi13,vi00,0x10
	nop                                	nop
	subz.w vf25w,vf26w,vf25z           	fmand vi13,vi13
	nop                                	ior vi13,vi13,vi07
	nop                                	iaddiu vi07,vi00,0x30
	nop                                	ibeq vi13,vi00,CI_NEXT_IN
	nop                                	div q,vf26w,vf25w
	nop                                	ibeq vi13,vi07,CLIP_PLANE_END
	nop                                	nop
	nop                                	nop
	sub.xyzw vf25xyzw,vf21xyzw,vf17xyzw	nop
	sub.xyzw vf26xyzw,vf22xyzw,vf18xyzw	nop
	sub.xyzw vf27xyzw,vf23xyzw,vf19xyzw	nop
	nop                                	nop
	mulq.xyzw vf25xyzw,vf25xyzw,q      	nop
	mulq.xyzw vf26xyzw,vf26xyzw,q      	nop
	mulq.xyzw vf27xyzw,vf27xyzw,q      	nop
	nop                                	nop
	add.xyzw vf25xyzw,vf25xyzw,vf17xyzw	nop
	add.xyzw vf26xyzw,vf26xyzw,vf18xyzw	iaddiu vi07,vi00,0x10
	add.xyzw vf27xyzw,vf27xyzw,vf19xyzw	nop
	nop                                	ibeq vi13,vi07,CO_NEXT_IN
	nop                                	nop
	nop                                	b CI_NEXT_OUT
	nop                                	nop
CO_NEXT_IN:
	nop                                	sqi.xyzw vf25xyzw,(vi09++)
	nop                                	sqi.xyzw vf26xyzw,(vi09++)
	nop                                	sqi.xyzw vf27xyzw,(vi09++)
	nop                                	iaddiu vi11,vi11,1
	nop                                	b CLIP_PLANE_END
	nop                                	nop
CI_NEXT_OUT:
	nop                                	sqi.xyzw vf17xyzw,(vi09++)
	nop                                	sqi.xyzw vf18xyzw,(vi09++)
	nop                                	sqi.xyzw vf19xyzw,(vi09++)
	nop                                	sqi.xyzw vf25xyzw,(vi09++)
	nop                                	sqi.xyzw vf26xyzw,(vi09++)
	nop                                	sqi.xyzw vf27xyzw,(vi09++)
	nop                                	iaddiu vi11,vi11,2
	nop                                	b CLIP_PLANE_END
	nop                                	nop
CI_NEXT_IN:
	nop                                	sqi.xyzw vf17xyzw,(vi09++)
	nop                                	sqi.xyzw vf18xyzw,(vi09++)
	nop                                	sqi.xyzw vf19xyzw,(vi09++)
	nop                                	iaddiu vi11,vi11,1
CLIP_PLANE_END:
	nop                                	jr vi02
	nop                                	nop
	.EndMPG
	.EndDmaData

; ---- vu1_DataSegment1: initial VU1 data memory and the double-buffer setup ----
	.global	vu1_DataSegment1
vu1_DataSegment1:
	DMAend *
	BASE VU1_BUF0
	OFFSET VU1_BUF_SIZE
	STCYCL 1, 1
	UNPACK V4_32, VU1_ADD_COLOR, *
	.float	0.0, 0.0, 0.0, 1.0		; add colour 0, opacity 1
	.EndUnpack
	STCYCL 1, 1
	UNPACK V4_32, VU1_SCALE_COLOR, *
	.float	0.0, 1.0, 0.0, 1.0
	.EndUnpack
	STCYCL 1, 1
	UNPACK V4_32, VU1_MVP, *
	.int	0, 0, 0, 1			; rewritten by every matrix setup
	.EndUnpack
	STCYCL 1, 1
	UNPACK V4_32, VU1_KICK_STATE, *
	.int	VU1_KICK_A, VU1_KICK_B, 0, 0
	.EndUnpack
	STCYCL 1, 1
	UNPACK V4_32, VU1_MP_STATE, *
	.int	VU1_MP_LIST, 0, 0, 1
	.EndUnpack
	STCYCL 1, 1
	UNPACK V4_32, VU1_COLOR128, *
	.float	128.0, 128.0, 128.0, 128.0
	.EndUnpack
	STCYCL 1, 1
	UNPACK V4_32, VU1_GIF_EOP, *
	.int	0x00008000, 0x10000000, 0x0000000e, 0	; NLOOP 0, EOP, NREG 1, REGS A+D
	.EndUnpack
	.EndDmaData
