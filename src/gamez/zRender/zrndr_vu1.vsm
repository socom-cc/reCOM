; Command 2: triangles that cross the frustum: clip each one (VU1_TRI_CLIPPER) and run the
; command list again from the entry's .y on the clipped polygon; vuNextClipTri (76) loops.
vuGatherClipTri:
	nop                                	ilw.x vi15,2(vi01)x
	nop                                	ilw.w vi12,2(vi01)w
	nop                                	nop
	nop                                	nop
	nop                                	iadd vi15,vi15,vi01
ClippedTriLoop:
	nop                                	iaddiu vi03,vi01,4
	nop                                	iaddiu vi11,vi00,1
	nop                                	ilw.w vi13,0(vi15)w
	nop                                	ilw.x vi05,0(vi15)x
	nop                                	ilw.y vi06,0(vi15)y
	nop                                	ilw.z vi07,0(vi15)z
	nop                                	iand vi11,vi13,vi11
	nop                                	iaddi vi15,vi15,2
	nop                                	ibeq vi11,vi00,vuNextClipTri
	nop                                	isw.z vi15,VU1_KICK_STATE(vi00)z
	nop                                	iaddiu vi11,vi00,2
	nop                                	iand vi13,vi13,vi11
	nop                                	isw.w vi13,VU1_CLIP_PKT(vi00)w
DrawClippedTri:
	nop                                	iadd vi05,vi03,vi05
	nop                                	lq.xyzw vf17xyzw,0(vi05)
	nop                                	lq.xyzw vf18xyzw,1(vi05)
	nop                                	lq.xyzw vf19xyzw,2(vi05)
	nop                                	iadd vi06,vi03,vi06
	nop                                	lq.xyzw vf26xyzw,0(vi06)
	nop                                	lq.xyzw vf27xyzw,1(vi06)
	nop                                	lq.xyzw vf28xyzw,2(vi06)
	nop                                	iadd vi07,vi03,vi07
	nop                                	lq.xyzw vf29xyzw,0(vi07)
	nop                                	lq.xyzw vf30xyzw,1(vi07)
	nop                                	lq.xyzw vf31xyzw,2(vi07)
	nop                                	iaddiu vi10,vi00,3
	nop                                	iaddiu vi11,vi00,3
	nop                                	bal vi15,VU1_TRI_CLIPPER
	nop                                	nop
	nop                                	ibeq vi10,vi00,vuNextClipTri
	nop                                	nop
ProcessClippedTri:
	nop                                	lq.xyzw vf22xyzw,0(vi01)
	nop                                	iaddiu vi11,vi10,0x7fff
	nop                                	iaddiu vi11,vi11,1
	nop                                	isw.x vi11,VU1_CLIP_PKT(vi00)x
	nop                                	sq.yz vf22yz,VU1_CLIP_PKT(vi00)
	nop                                	b vuProcessNextCommand
	nop                                	nop
vuNextClipTri:
	nop                                	iaddi vi12,vi12,-1
	nop                                	ilw.z vi15,VU1_KICK_STATE(vi00)z
	nop                                	ibeq vi12,vi00,ClippedTriDone
	nop                                	nop
	nop                                	ilw.y vi14,VU1_PROGRAM(vi14)y
	nop                                	b ClippedTriLoop
	nop                                	nop
ClippedTriDone:
	nop                                	b vuSleep
	nop                                	nop

; Command 4: the same for lines (VU1_LINE_CLIPPER); vuNextClipLine (78) loops.
vuGatherClipLine:
	nop                                	ilw.x vi10,1(vi01)x
	nop                                	nop
	nop                                	iaddiu vi11,vi00,0x7fff
	nop                                	iand vi12,vi10,vi11
	nop                                	iaddiu vi10,vi01,2
	nop                                	iaddi vi12,vi12,-1
	nop                                	lq.xyzw vf22xyzw,0(vi01)
	nop                                	iaddiu vi11,vi11,3
	nop                                	nop
	nop                                	isw.x vi11,VU1_CLIP_PKT(vi00)x
	nop                                	sq.yzw vf22yzw,VU1_CLIP_PKT(vi00)
ClippedLineLoop:
	nop                                	lq.xyzw vf17xyzw,0(vi10)
	nop                                	lq.xyzw vf19xyzw,1(vi10)
	nop                                	lq.xyzw vf18xyzw,2(vi10)
	nop                                	lq.xyzw vf21xyzw,3(vi10)
	nop                                	lq.xyzw vf23xyzw,4(vi10)
	nop                                	lq.xyzw vf22xyzw,5(vi10)
	nop                                	iaddiu vi10,vi10,3
	nop                                	iaddiu vi11,vi00,2
	nop                                	bal vi15,VU1_LINE_CLIPPER
	nop                                	nop
	nop                                	ibeq vi11,vi00,vuNextClipLine
	nop                                	nop
	nop                                	sq.xyzw vf17xyzw,VU1_VTX_A(vi00)
	nop                                	sq.xyzw vf19xyzw,VU1_VTX_A+1(vi00)
	nop                                	sq.xyzw vf18xyzw,VU1_VTX_A+2(vi00)
	nop                                	sq.xyzw vf21xyzw,VU1_VTX_A+3(vi00)
	nop                                	sq.xyzw vf23xyzw,VU1_VTX_A+4(vi00)
	nop                                	sq.xyzw vf22xyzw,VU1_VTX_A+5(vi00)
	nop                                	iaddiu vi04,vi00,VU1_GIF_EOP
	nop                                	xgkick vi04
	nop                                	nop
	nop                                	b vuProcessNextCommand
	nop                                	nop
vuNextClipLine:
	nop                                	iaddi vi12,vi12,-1
	nop                                	nop
	nop                                	ibeq vi12,vi00,ClippedLineDone
	nop                                	nop
	nop                                	ilw.y vi14,VU1_PROGRAM(vi14)y
	nop                                	b ClippedLineLoop
	nop                                	nop
ClippedLineDone:
	nop                                	b vuSleep
	nop                                	nop

; Command 114: VU1_MP_STATE.w = 0.
vuMultipassing:
	nop                                	isw.w vi00,VU1_MP_STATE(vi00)w
	nop                                	b vuProcessNextCommand
	nop                                	nop

; Command 116: VU1_MP_STATE.w = 2.
vuNotMultipassing:
	nop                                	iaddiu vi03,vi00,2
	nop                                	isw.w vi03,VU1_MP_STATE(vi00)w
	nop                                	b vuProcessNextCommand
	nop                                	nop

